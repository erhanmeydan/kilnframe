{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": ["@adobe/premierepro"],
    "resolveJsonModule": true
  },
  "include": [
    "index.ts",
    "index-resolve.ts",
    "src/**/*.ts",
    "probe/**/*.ts",
    "../app/node_modules/electron/electron.d.ts"
  ]
}

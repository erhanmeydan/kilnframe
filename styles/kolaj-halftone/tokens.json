{
  "name": "kolaj-halftone",
  "displayName": { "en": "Halftone Collage", "tr": "Kolaj Halftone" },
  "description": {
    "en": "Torn paper collage, large halftone dots, tape and letters cut from different fonts.",
    "tr": "Yırtık kağıt kolajı, iri halftone noktalar, bant ve farklı fontlardan kesik harfler."
  },
  "colors": {
    "background": "#E9E4D8",
    "red": "#B5463A",
    "blue": "#5E7A93",
    "ink": "#151515",
    "paperLight": "#F1ECE0",
    "tape": "rgba(240,236,224,0.6)"
  },
  "colorRules": {
    "red": "the highlight: key bar, arrows, sound waves",
    "ink": "halftone dots, pictograms, letters",
    "noPhotos": "never photographs or photorealistic shading"
  },
  "fonts": {
    "cutoutSet": [
      {
        "family": "Archivo",
        "file": "vendor/fonts/archivo/Archivo-Variable.ttf",
        "weight": 900,
        "width": 100,
        "role": "heavy grotesk"
      },
      {
        "family": "Anton",
        "file": "vendor/fonts/anton/Anton-Regular.ttf",
        "weight": 400,
        "role": "condensed sans"
      },
      {
        "family": "Alfa Slab One",
        "file": "vendor/fonts/alfa-slab-one/AlfaSlabOne-Regular.ttf",
        "weight": 400,
        "role": "slab serif"
      }
    ],
    "cutoutRule": "each character or word of a cut-out headline uses a font from the set, chosen by a seeded sequence so neighbors differ; each sits on its own torn paper piece, rotated -6..6 deg",
    "body": {
      "family": "Archivo",
      "file": "vendor/fonts/archivo/Archivo-Variable.ttf",
      "weight": 700,
      "width": 100
    }
  },
  "halftone": {
    "dotSpacingAt1080Short": 13,
    "angleDeg": 45,
    "dotSize": "even, never modulated by light",
    "use": "fills of pictograms, bars, arcs and small frames"
  },
  "paper": {
    "tornEdge": {
      "irregularityPx": 6,
      "rimWidthPx": 3,
      "rimColor": "#F6F2E8",
      "seeded": true,
      "seed": 13
    },
    "grain": {
      "opacity": 0.04,
      "seed": 8
    },
    "shadow": {
      "offsetY": 2,
      "blur": 4,
      "color": "rgba(40,30,20,0.22)"
    },
    "clean": "no wrinkles, creases or stains"
  },
  "tape": {
    "widthAt1080Short": 70,
    "rotationDeg": [-12, 12],
    "edges": "slightly jagged short ends"
  },
  "motion": {
    "enter": {
      "type": "pieces slap onto the page: quick scale from 1.08 to 1 with a tiny rotation settle",
      "ease": "power4.out",
      "duration": 0.22,
      "stagger": 0.09
    },
    "tape": "tape strips land a beat after the piece they hold",
    "holdJitter": "on beats pieces can jump to a new tiny rotation (stop-motion feel, 12 fps steps), seeded",
    "exit": {
      "type": "pieces are pulled off the page upward",
      "ease": "power2.in",
      "duration": 0.25
    },
    "transition": "a big torn sheet is slapped over the frame and becomes the next background"
  },
  "type": {
    "headlineSizeAt1080Short": 120,
    "numberSizeAt1080Short": 240,
    "maxHeadlinesPerScene": 1
  },
  "safeArea": {
    "landscape": "to be defined in M1",
    "portrait": "to be defined in M1",
    "square": "to be defined in M1"
  }
}
